# Local development ONLY. Production authentication is not implemented yet.
SIMSAIMDANG_DEMO_AUTH=true
DATABASE_URL=sqlite:///./simsaimdang.db
# PostgreSQL integration: copy infra/.env.example to infra/.env first.
# DATABASE_URL=postgresql+psycopg://simsa:simsa_local_only@localhost:5432/simsa
# --- 평가위원 본인확인 데모 (로컬 전용, u-jing) ---
# APP_ENV=preview/production 이면 아래 두 값과 DEMO_AUTH가 켜져 있을 때 서버가 기동을 거부한다.
APP_ENV=local
# 6자리 숫자. 비어 있으면 데모 본인확인이 꺼진다. 응답·로그에 노출되지 않는다.
DEMO_VERIFY_CODE=000000
# 평가위원 세션 토큰 서명 키. 로컬은 임의 문자열, 배포는 서버 환경변수로만 주입한다.
SESSION_SECRET=local-dev-only-change-me
